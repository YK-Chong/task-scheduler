{
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=taskscheduler;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Quartz": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "JobSettings": {
    "MasterServerSyncJob": {
      "IntervalSeconds": 3600
    },
    "SymbolDataPullJob": {
      "IntervalSeconds": 300
    }
  }
}